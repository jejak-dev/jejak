{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Jejak",
  "version": "0.0.1",
  "identifier": "io.github.jejak-dev.jejak",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/jejak"],
    "category": "DeveloperTool",
    "shortDescription": "Workbench agent coding",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    }
  }
}
