{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Jejak",
  "version": "0.1.0-beta.9",
  "identifier": "io.github.jejak-dev.jejak",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/jejak"],
    "category": "DeveloperTool",
    "shortDescription": "Workbench agent coding",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3MjcyOUI5QzhFRDExMzAKUldRd0VlM0l1U2tuTjZ3R1BBZjNwVzl2OXROakVZMUwwbmtpNWw4T0ZNbVZNNS9lajd1VnlZNVoK",
      "endpoints": [
        "https://github.com/jejak-dev/jejak/releases/latest/download/latest.json"
      ]
    }
  }
}
