{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "Izin notifikasi native untuk halaman Jejak yang dilayani di loopback.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
