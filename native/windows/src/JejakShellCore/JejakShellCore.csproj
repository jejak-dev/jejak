<Project Sdk="Microsoft.NET.Sdk">
  <!-- Inti tanpa Win32 (net8.0 biasa) supaya bisa diuji di Mac/Linux. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Jejak.Shell</RootNamespace>
    <AssemblyName>JejakShellCore</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ed25519 + BLAKE2b untuk verifikasi minisign; .NET tak punya keduanya. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>
</Project>
