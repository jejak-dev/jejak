{
  "name": "jejak",
  "version": "0.1.0-beta.9",
  "description": "Workbench agent coding dengan memory lintas repo dan analisis dampak.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "jejak": "src/cli/index.ts"
  },
  "files": [
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "INSTALL.md",
    "INSTALL.id.md",
    "install.sh"
  ],
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "JEJAK_DEV=1 bun run --hot src/cli/index.ts serve",
    "start": "bun run src/cli/index.ts serve",
    "doctor": "bun run src/cli/index.ts doctor",
    "test": "bun test",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "build:binary": "bun run scripts/build-binary.ts",
    "stage:sidecar": "bun run scripts/stage-sidecar.ts",
    "build:apk": "bash android/build.sh",
    "build:desktop": "bun run scripts/build-desktop.ts",
    "smoke:binary": "bun run scripts/smoke-binary.ts",
    "check:version": "bun run scripts/check-version.ts",
    "release": "bun run scripts/release.ts"
  },
  "dependencies": {
    "elysia": "^1.4.0",
    "mermaid": "^12.3.0",
    "preact": "^10.29.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "typescript": "~5.8.2"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0 <1"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  }
}
